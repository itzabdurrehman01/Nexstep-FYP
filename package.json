{
  "name": "nexstep-backend",
  "version": "1.0.0",
  "description": "NexStep \u2014 Express/Node.js backend with PostgreSQL",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch --clear-screen=false server.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "migrate": "node node_modules/tsx/dist/cli.mjs db/migrate.ts",
    "migrate:phase26": "node node_modules/tsx/dist/cli.mjs db/migrate_phase26.ts",
    "migrate:real-data": "node node_modules/tsx/dist/cli.mjs db/migrate_real_data_pipeline.ts",
    "seed": "node node_modules/tsx/dist/cli.mjs db/seed.ts",
    "migrate:scope-gaps": "node node_modules/tsx/dist/cli.mjs db/migrate_scope_gaps.ts",
    "data:ingest:jobs-csv": "node node_modules/tsx/dist/cli.mjs scripts/ingest_jobs_csv.ts",
    "data:seed:questions": "node node_modules/tsx/dist/cli.mjs scripts/seed_entry_test_questions.ts",
    "data:seed:merit": "node node_modules/tsx/dist/cli.mjs scripts/seed_merit_cutoffs.ts",
    "data:ingest:dry": "node node_modules/tsx/dist/cli.mjs scripts/ingest.ts --dry-run --all",
    "data:seed-authentic": "node node_modules/tsx/dist/cli.mjs scripts/seed_authentic_data.ts",
    "data:ingest:skills": "node node_modules/tsx/dist/cli.mjs scripts/ingest.ts --source=skills",
    "data:ingest:careers": "node node_modules/tsx/dist/cli.mjs scripts/ingest.ts --source=careers",
    "db:check": "node node_modules/tsx/dist/cli.mjs db/check_integrity.ts",
    "guardrails": "node node_modules/tsx/dist/cli.mjs scripts/check_hardcoded_route_scores.ts && node node_modules/tsx/dist/cli.mjs scripts/test_hardcoded_score_scanner.ts && node node_modules/tsx/dist/cli.mjs scripts/test_pure_formula_verification.ts && node node_modules/tsx/dist/cli.mjs scripts/check_test_authenticity.ts && node node_modules/tsx/dist/cli.mjs scripts/test_serving_approval_gate.ts && node node_modules/tsx/dist/cli.mjs scripts/test_verification_counter_guardrail.ts",
    "test": "npm run guardrails",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clerk/express": "^2.0.0",
    "@google/genai": "^2.24.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "6.9.16",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.11.14",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
