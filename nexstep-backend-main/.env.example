# ─────────────────────────────────────────────────────────────────────────────
# NexStep — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
# Backend API port (frontend dev server runs separately on port 5173)
PORT=3001
NODE_ENV=development
# Public web app URL used in account emails and by hosted payment providers.
# APP_URL is retained as a backwards-compatible fallback.
PUBLIC_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173
PAYMENT_RETURN_URL=http://localhost:5173/#/pricing

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Ensure PostgreSQL is running before starting the server.
# Run migrations: npm run migrate
# Seed dev accounts: npm run seed
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=nexstep_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters. Change before any production deployment.
# ── Authentication (Clerk) ── https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Legacy (no longer used for sign-in since the move to Clerk)
JWT_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_SECRET

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/callback (or http://localhost:3001/api/auth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/callback

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Required for: AI chat, career explanation, interview evaluation, translation.
# Free tier available at: https://aistudio.google.com/
# Leave empty in dev to disable AI features (all other features work without it).
GEMINI_API_KEY=
# Optional model override. Leave empty for automatic discovery.
GEMINI_MODEL=
# Optional diagnostic request at boot. Keep false to preserve free-tier quota.
GEMINI_SMOKE_TEST=false

# ── Google Cloud Translation API ─────────────────────────────────────────────
# Required for: Dynamic English → Urdu translation of database/API content.
# Enable "Cloud Translation API" at https://console.cloud.google.com/apis/
# Free tier: 500,000 characters/month.
# Leave empty to fall back to Gemini-based batch translation (slower, costs quota).
GOOGLE_TRANSLATE_API_KEY=

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# In development (NODE_ENV=development):
#   - Ethereal fake SMTP is used automatically — no config needed.
#   - Preview URLs are printed to console when emails are triggered.
# In production: set these to your real SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexstep.edu.pk

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max AI requests per authenticated user per minute.
AI_RATE_LIMIT_PER_MIN=10

# ── Payments — JazzCash ───────────────────────────────────────────────────────
# Keep disabled until merchant credentials and webhook URLs are configured.
# Allowed values: disabled, test, live
PAYMENTS_MODE=disabled
# Apply at: https://sandbox.jazzcash.com.pk (sandbox) or JazzCash merchant portal
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_KEY=
# Sandbox: https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Production: https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ── Payments — Easypaisa ─────────────────────────────────────────────────────
# Apply at: https://easypaisa.com.pk/merchant or contact Telenor Microfinance Bank
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_BASE_URL=https://easypaisa.com.pk/api

# ── Payments — Bank Transfer ──────────────────────────────────────────────────
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
