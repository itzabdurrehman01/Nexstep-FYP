# ─────────────────────────────────────────────────────────────────────────────
# NexStep — Frontend Environment Variables
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Copy this to frontend/.env when running standalone.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL used by the Vite dev proxy (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Clerk publishable key (same pk_... value as backend CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Enable Google under Clerk Dashboard → Configure → SSO connections
# Allowed redirect: http://localhost:5173/#/sso-callback
# Passwords follow Clerk: 15 characters or more.
