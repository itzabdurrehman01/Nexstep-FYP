# NexStep Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Backend API base URL
# Development (local):   http://192.168.x.x:3001  (use your machine's LAN IP, not localhost)
# Production:            https://api.nexstep.edu.pk
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# App environment
EXPO_PUBLIC_ENV=development

# Clerk Auth
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
# Enable Google under Clerk Dashboard → Configure → SSO connections
# Native redirect scheme: nexstep://sso-callback
