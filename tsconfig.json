{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@backend/*": ["./src/*"]
    }
  },
  "include": ["server.ts", "src/**/*", "db/**/*"],
  "exclude": ["node_modules", "dist"]
}
